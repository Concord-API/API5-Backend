{
  "ConnectionStrings": {
    "Ratio": "Host=<host>;Port=5432;Database=<database>;Username=<read-only-user>;Password=<password>"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenTelemetry": {
    "Endpoint": "http://127.0.0.1:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/Ratio/logs/ratio-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
