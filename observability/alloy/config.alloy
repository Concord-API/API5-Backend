otelcol.receiver.otlp "api" {
  grpc {
    endpoint = "127.0.0.1:4317"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://127.0.0.1:9090/api/v1/write"
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://127.0.0.1:3100/otlp"
  }
}

prometheus.exporter.blackbox "api" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"

  target {
    name    = "live"
    address = "http://127.0.0.1:5000/health"
    module  = "http_2xx"
  }

  target {
    name    = "ready"
    address = "http://127.0.0.1:5000/health/ready"
    module  = "http_2xx"
  }
}

prometheus.scrape "api_health" {
  targets         = prometheus.exporter.blackbox.api.targets
  forward_to      = [prometheus.remote_write.local.receiver]
  scrape_interval = "1m"
  scrape_timeout  = "10s"
}

prometheus.exporter.windows "host" {
  enabled_collectors = ["cpu", "logical_disk", "memory", "net", "os", "service", "system", "iis"]

  service {
    include = "ratio-.*|postgresql.*|Alloy|Grafana|W3SVC|WAS"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.windows.host.targets
  forward_to      = [prometheus.remote_write.local.receiver]
  scrape_interval = "1m"
  scrape_timeout  = "30s"
}

prometheus.exporter.postgres "ratio" {
  data_source_names  = [coalesce(sys.env("RATIO_MONITOR_DSN"), "postgresql://ratio_monitor@127.0.0.1:5432/ratio?sslmode=disable")]
  enabled_collectors = ["database", "locks", "replication", "replication_slot", "roles", "stat_bgwriter", "stat_database", "stat_progress_vacuum", "stat_statements", "stat_user_tables", "statio_user_tables", "wal"]

  stat_statements {
    include_query = true
    limit         = 50
    query_length  = 200
  }
}

prometheus.scrape "postgres" {
  targets         = prometheus.exporter.postgres.ratio.targets
  forward_to      = [prometheus.remote_write.local.receiver]
  scrape_interval = "1m"
  scrape_timeout  = "30s"
}
