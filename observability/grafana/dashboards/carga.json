    {
      "type": "timeseries",
      "title": "Usuários virtuais",
      "description": "Quantos usuários o k6 simula a cada momento: mostra quando a carga sobe, fica e desce.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
