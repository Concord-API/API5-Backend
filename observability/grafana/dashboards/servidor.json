    {
      "type": "timeseries",
      "title": "Requisições no IIS por site",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (site) (rate(windows_iis_requests_total[$__rate_interval])) * 60",
          "legendFormat": "{{site}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(windows_iis_not_found_errors_total[$__rate_interval])) * 60",
          "legendFormat": "404"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/min",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
