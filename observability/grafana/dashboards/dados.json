  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ratio"
      ],
      "asDropdown": false,
      "title": "Painéis",
      "includeVars": false,
      "keepTime": true
