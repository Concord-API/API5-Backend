        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Estado do DW ao longo do tempo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ratio_warehouse_availability{state=\"ready\"}) * 1 + max(ratio_warehouse_availability{state=\"empty\"}) * 2 + max(ratio_warehouse_availability{state=\"unavailable\"}) * 3",
          "legendFormat": "DW"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Pronto",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "Sem carga publicada",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "Banco inacessível",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "grey",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
