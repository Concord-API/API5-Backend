        "h": 7,
        "w": 8,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Coletas de lixo por minuto",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gc_heap_generation) (rate(dotnet_gc_collections_total[$__rate_interval])) * 60",
          "legendFormat": "{{gc_heap_generation}}"
